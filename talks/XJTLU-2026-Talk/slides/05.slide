<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', position: 'relative', fontFamily: 'Source Han Sans, Noto Sans CJK SC, sans-serif' }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: 60, background: '#330662' }}>
    <Text style={{ color: '#FFFFFF', fontSize: 22, fontWeight: 'bold', padding: '14px 60px' }}>It compiles. It runs. It is structurally vacuous.</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 100, left: 60, width: 200, flexDirection: 'column', gap: 4 }}>
    <Text style={{ fontSize: 16, color: '#57068C', fontWeight: 'bold', letterSpacing: 2 }}>THE EMPIRICAL DIAGNOSIS</Text>
    <Box style={{ width: 40, height: 3, background: '#57068C' }} />
  </Box>
  <Box style={{ position: 'absolute', top: 160, left: 60, right: 60, height: 320, flexDirection: 'row', gap: 16 }}>
    {[
      { n: 'F1 ≈ 0.12', sub: 'mechanism fidelity of direct NL→C#', src: 'Mage · arXiv:2605.07342', tone: '#D9534F' },
      { n: '80.4 → 5.7%', sub: 'runtime pass-rate cliff at project scale', src: 'JAMER · arXiv:2606.19830', tone: '#57068C' },
      { n: '41.46%', sub: 'best coding agent, end-to-end benchmark', src: 'GameCraft-Bench · arXiv:2606.17861', tone: '#57068C' },
      { n: '+37.1 pt', sub: 'rubric gain with a GUI-agent playtester', src: 'Play2Code · arXiv:2605.28258', tone: '#7B5AA6' },
    ].map((kpi, i) => (
      <Box key={i} style={{ flex: 1, padding: 20, background: '#FAF8FC', border: '1px solid #E4DCEC', borderRadius: 10, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: kpi.tone, fontFamily: 'Source Serif Pro, Georgia, serif', lineHeight: 1.1 }}>{kpi.n}</Text>
        <Box style={{ width: 32, height: 2, background: '#D9D0E4' }} />
        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.4, flex: 1 }}>{kpi.sub}</Text>
        <Text style={{ fontSize: 12, color: '#8B97A8' }}>{kpi.src}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ position: 'absolute', top: 510, left: 60, right: 60, height: 130, padding: 20, background: '#330662', borderRadius: 10, flexDirection: 'column', gap: 8 }}>
    <Text style={{ fontSize: 14, color: '#FFC107', fontWeight: 'bold', letterSpacing: 2 }}>DATA → JUDGMENT</Text>
    <Text style={{ fontSize: 22, color: '#FFFFFF', lineHeight: 1.4, fontWeight: 'bold' }}>
      Compile rate and functional correctness are anti-correlated.
    </Text>
    <Text style={{ fontSize: 17, color: '#EEE6F3', lineHeight: 1.5 }}>
      Failure lives in structure and architecture, not in syntax. The largest single proven gain comes not from better prompts but from putting a playtester in the loop.
    </Text>
  </Box>
  <Box style={{ position: 'absolute', top: 680, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>Xingchen Zhang · NYU Shanghai · XJTLU 2026 · Panel 11</Text>
    <Text style={{ fontSize: 14, color: '#57068C', fontWeight: 'bold' }}>05 / 16</Text>
  </Box>
</Slide>
